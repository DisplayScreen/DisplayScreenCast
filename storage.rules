rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Event assets folder
    match /events/{eventId}/assets/{allPaths=**} {
      // Public displays can read/download images, videos, and logos
      allow read: if true;
      // Only authenticated admins can upload or delete assets
      allow write: if request.auth != null;
    }
  }
}
